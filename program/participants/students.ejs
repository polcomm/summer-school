```{=html}
<style>
  .students-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding: 1rem 0;
  }

  .student-card {
    display: flex;
    flex-direction: column;
  }

  .student-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }

  .student-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .student-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.3rem;
  }

  .student-name {
    font-weight: 600;
    font-size: 1rem;
    margin: 0;
    color: #0a3263;
    line-height: 1.25;
  }

  .student-icons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .student-icons a {
    color: #0a3263;
    font-size: 1rem;
    opacity: 0.75;
    text-decoration: none;
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .student-icons a:hover {
    opacity: 1;
  }

  .bsky-icon {
    width: 1em;
    height: 1em;
    fill: currentColor;
  }

  .student-bio {
    background-color: #eaf6e8;
    border-left: 3px solid #3fb618;
    padding: 0.7rem 0.9rem;
    margin-top: 0.75rem;
    font-size: 0.83rem;
    line-height: 1.55;
    color: #2d4a28;
    border-radius: 0 4px 4px 0;
    box-sizing: border-box;
  }

  @media (max-width: 991px) {
    .students-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 576px) {
    .student-photo {
      width: 64px;
      height: 64px;
    }
    .student-bio {
      font-size: 0.8rem;
    }
  }
</style>

<div class="students-grid">
  <% for (const item of items) { %>
  <div class="student-card">
    <div class="student-header">
      <a href="<%- item.href %>" target="_blank" style="flex-shrink:0;display:block;">
        <img src="<%- item.thumbnail %>" alt="<%= item.name %> picture" style="width:80px;height:80px;border-radius:50%;object-fit:cover;display:block;margin:0;flex-shrink:0;" />
      </a>
      <div class="student-meta">
        <p class="student-name"><%= item.name %></p>
        <div class="student-icons">
          <% for (const tile of item.social) { %>
            <% if (tile.website) { %><a href="<%- tile.website %>" target="_blank"><i class="bi bi-globe"></i></a><% } %>
            <% if (tile.github) { %><a href="<%- tile.github %>" target="_blank"><i class="bi bi-github"></i></a><% } %>
            <% if (tile.twitter) { %><a href="<%- tile.twitter %>" target="_blank"><i class="bi bi-twitter"></i></a><% } %>
            <% if (tile.linkedin) { %><a href="<%- tile.linkedin %>" target="_blank"><i class="bi bi-linkedin"></i></a><% } %>
            <% if (tile.facebook) { %><a href="<%- tile.facebook %>" target="_blank"><i class="bi bi-facebook"></i></a><% } %>
            <% if (tile.bluesky) { %>
            <a href="<%- tile.bluesky %>" target="_blank">
              <svg class="bsky-icon" viewBox="0 0 360 320" xmlns="http://www.w3.org/2000/svg">
                <path d="M180 142c-16.3-31.7-60.7-90.8-102-120C38.5-5.9 23.4-1 13.5 3.4 2.1 8.6 0 26.2 0 36.5c0 10.4 5.7 84.8 9.4 97.2 12.2 41 55.7 55 95.7 50.5-58.7 8.6-110.8 30-73.9 106.8 35.3 74.6 89.7 55.2 120.8 41.5 9-3.9 17.3-7.5 24-10.1 6.7 2.6 15 6.2 24 10.1 31.1 13.7 85.5 33.1 120.8-41.5 36.9-76.8-15.2-98.2-73.9-106.8 40 4.4 83.5-9.5 95.7-50.5 3.7-12.4 9.4-86.8 9.4-97.2 0-10.3-2.1-27.9-13.5-33.1C336.6-1 321.5-5.9 282 22c-41.3 29.2-85.7 88.3-102 120Z"/>
              </svg>
            </a>
            <% } %>
            <% if (tile.mastodon) { %><a href="<%- tile.mastodon %>" target="_blank"><i class="bi bi-mastodon"></i></a><% } %>
          <% } %>
        </div>
      </div>
    </div>
    <% if (item.bio) { %>
    <div class="student-bio"><%= item.bio %></div>
    <% } %>
  </div>
  <% } %>
</div>
```
