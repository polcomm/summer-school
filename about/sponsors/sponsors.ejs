```{=html}
<div class='sponsorsFooter' style="text-align:center; margin-top:3rem;">

  <h1 id="sponsorTitle"><strong>Our Sponsors</strong></h1>

  <ul style="
      list-style:none;
      padding:0;
      margin:1.5rem 0 0 0;
      display:flex;
      justify-content:center;
      align-items:center;
      flex-wrap:wrap;
      gap:40px;
  ">
    <% for (const item of items) { %>
      <li style="display:flex; align-items:center; justify-content:center;">
        <a href="<%- item.href %>" target="_blank">
          <img src="<%- item.thumbnail %>" alt="<%= item.name %> logo" style="height:86px; width:auto;">
        </a>
      </li>
    <% } %>
  </ul>

</div>

```